---
import Book from '../../layouts/Book.astro';
import Demo from '../../components/Demo.astro';
import {lessons,exercises,lessonMarkdown,render,moduleNames,label,type Lesson} from '../../lib/content';
import revisits from '../../content/module-revisits.json';
import {demoIds} from '../../lib/demos';
export function getStaticPaths(){return lessons.filter(l=>l.editorial!=='planned'&&l.file).map(lesson=>({params:{id:lesson.id},props:{lesson}}))}
interface Props{lesson:Lesson}
const {lesson}=Astro.props;
const body=await render(lessonMarkdown(lesson));
const practice=exercises.filter(e=>e.lesson===lesson.id);
const index=lessons.findIndex(l=>l.id===lesson.id);
const previous=lessons.slice(0,index).reverse().find(l=>l.editorial!=='planned');
const next=lessons.slice(index+1).find(l=>l.editorial!=='planned');
const demo=demoIds.includes(lesson.id);
const revisit=revisits.find(r=>r.lesson===lesson.id);
const sections=[...body.sections,...(demo?[{id:'interactive-example',title:'Step through the example'}]:[]),...(revisit?[{id:'module-revisit',title:'Revisit the module'}]:[]),{id:'practice',title:'Practice & explained answers'}];
---
<Book title={lesson.title} current={lesson.id} sections={sections} description={lesson.summary}>
<article data-lesson-id={lesson.id}>
<div class="breadcrumb"><a href="/">The textbook</a> / <a href={`/index/#module-${lesson.module}`}>Module {String(lesson.module).padStart(2,'0')}</a> / Lesson {String(lesson.sequence).padStart(2,'0')}</div>
<div class="lesson-kicker"><span class="eyebrow">{moduleNames[lesson.module]}</span><span class:list={['badge',{partial:lesson.editorial==='partial'}]}>{lesson.editorial==='complete'?'Authored · not independently reviewed':lesson.editorial==='reviewed'?'Reviewed':lesson.editorial}</span></div>
<h1>{lesson.title}</h1><p class="dek">{lesson.summary}</p>
<div class="lesson-metadata"><span>{lesson.kind}</span><span>{lesson.path==='main'?'Main path':'Optional branch'}</span><span>{Math.ceil(body.text.split(/\s+/).length/150)} min reading + calculation</span><span>Lesson {String(lesson.sequence).padStart(2,'0')}</span></div>
<div class="context-box"><p><strong>The point of this lesson.</strong> {lesson.why}</p><p><strong>Useful prerequisites.</strong> {lesson.prerequisites.length?lesson.prerequisites.map((id,i)=><Fragment>{i>0?' · ':''}<a href={`/lessons/${id}/`}>{lessons.find(l=>l.id===id)?.title??id}</a></Fragment>):'Start here. Essential mathematics is introduced in the worked example.'}</p><p class="small"><strong>Advantage status:</strong> {lesson.advantage}</p></div>
{lesson.editorial==='partial'&&<aside class="partial-notice"><strong>This chapter is partial.</strong> The material below is usable, but these teaching gaps remain:<ul>{lesson.gaps.map(g=><li>{g}</li>)}</ul></aside>}
<div class="prose" set:html={body.html}/>
{demo&&<><h2 id="interactive-example">Step through the example</h2><Demo id={lesson.id}/></>}
{revisit&&<section class="prose" id="module-revisit"><h2>Revisit the module</h2><p>{revisit.body}</p></section>}
<section id="practice" class="prose"><h2>Practice & explained answers</h2><p>Predict first. Then calculate with the definitions available. A correct prediction after changing one operation is stronger evidence of understanding than recognizing a formula.</p>{practice.map((e,i)=><div><h3>Check {i+1}</h3><p>{e.question}</p><details><summary>Reveal worked answer</summary><p>{e.answer}</p></details></div>)}</section>
<div class="lesson-actions"><p>Record your own assessment. Scrolling never marks a lesson understood.</p><div class="progress-controls"><button data-progress="read" aria-pressed="false">Read</button><button data-progress="practiced" aria-pressed="false">Practiced</button><button data-progress="revisit" aria-pressed="false">Revisit</button></div><p class="small muted" data-progress-status></p></div>
<nav class="prev-next" aria-label="Lesson sequence">{previous?<a href={`/lessons/${previous.id}/`}><span>← PREVIOUS LESSON</span>{label(previous)}</a>:<a href="/"><span>← ORIENTATION</span>How to use this book</a>}{next?<a href={`/lessons/${next.id}/`}><span>NEXT LESSON →</span>{label(next)}</a>:<a href="/coverage/"><span>THE WHOLE PICTURE →</span>Coverage and next reading</a>}</nav>
</article>
</Book>
