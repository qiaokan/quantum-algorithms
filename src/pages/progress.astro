---
import Book from '../layouts/Book.astro';import{lessons,label,decisionLessons}from'../lib/content';
const route=decisionLessons();
---
<Book title="Your reading progress"><span class="eyebrow">LOCAL TO THIS BROWSER</span><h1>Your reading progress</h1><p class="dek">Your assessment is separate from whether a chapter has been editorially completed or reviewed.</p><p class="small muted">Stored only in this browser. Clearing site data removes it. Scrolling records a return location, never a learning status.</p><section class="decision-progress context-box" aria-labelledby="decision-progress-heading"><h2 id="decision-progress-heading" class="path-module">Decision path</h2><p data-decision-summary>0 of {route.length} decision-path lessons marked.</p><ol class="catalog-list">{route.map(l=><li><a href={`/lessons/${l.id}/`}>{label(l)}</a><p data-decision-status-for={l.id}>Not marked</p></li>)}</ol></section><h2 class="path-module">All lessons</h2><ul class="catalog-list">{lessons.filter(l=>l.editorial!=='planned').map(l=><li><a href={`/lessons/${l.id}/`}>{label(l)}</a><p data-status-for={l.id}>Not marked</p></li>)}</ul><button id="export-progress">Export progress JSON</button> <button id="clear-progress">Clear learning statuses</button><p id="progress-message" role="status" class="small"></p></Book>
<script>
import {storage,parseProgress} from '../lib/storage';
let progress=parseProgress(storage.get('qa-progress','{}'));
function draw(){document.querySelectorAll<HTMLElement>('[data-status-for]').forEach(el=>el.textContent=progress[el.dataset.statusFor!]||'Not marked');
 // Decision-path progress reads the same store; it is a separate view, not a separate record.
 const decision=[...document.querySelectorAll<HTMLElement>('[data-decision-status-for]')];decision.forEach(el=>el.textContent=progress[el.dataset.decisionStatusFor!]||'Not marked');
 const marked=decision.filter(el=>progress[el.dataset.decisionStatusFor!]),practiced=marked.filter(el=>progress[el.dataset.decisionStatusFor!]==='practiced');
 const summary=document.querySelector('[data-decision-summary]');if(summary)summary.textContent=`${marked.length} of ${decision.length} decision-path lessons marked; ${practiced.length} practiced.`};draw();
document.querySelector<HTMLButtonElement>('#clear-progress')!.onclick=()=>{progress=parseProgress('{}');storage.remove('qa-progress');draw();document.querySelector('#progress-message')!.textContent='Learning statuses cleared. Reading locations are preserved.'};
document.querySelector<HTMLButtonElement>('#export-progress')!.onclick=()=>{const blob=new Blob([JSON.stringify({format:'quantum-algorithms-progress-v1',progress},null,2)],{type:'application/json'});const a=document.createElement('a'),url=URL.createObjectURL(blob);a.href=url;a.download='quantum-learning-progress.json';a.click();setTimeout(()=>URL.revokeObjectURL(url),1000)};
</script>
