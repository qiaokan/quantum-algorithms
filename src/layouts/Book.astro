---
import '../styles/book.css';
import 'katex/dist/katex.min.css';
import {lessons,moduleNames,label,tier,decisionLessons,type Section} from '../lib/content';
const decision=decisionLessons();
const deferredCount=lessons.filter(l=>tier(l)==='deferred'&&l.editorial!=='planned').length;
interface Props { title: string; current?: string; sections?: Section[]; description?: string; tocLabel?: string }
const {title,current='',sections=[],description='An algorithm-first quantum computing textbook with worked mathematics and honest simulations.',tocLabel='IN THIS LESSON'}=Astro.props;
---
<!doctype html>
<html lang="en">
<head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content={description}/><meta name="color-scheme" content="light dark"/><title>{title} · Quantum Algorithms</title>
<script is:inline>try{document.documentElement.dataset.theme=localStorage.getItem('qa-theme')||'light'}catch{}</script>
</head>
<body>
<a href="#main" class="skip-link">Skip to lesson</a>
<header class="topbar"><button id="menu-toggle" class="mobile-menu" aria-label="Open contents" aria-expanded="false" aria-controls="sidebar">☰ <span>Contents</span></button><a class="wordmark" href="/"><span class="wordmark-icon" aria-hidden="true">ψ</span><span>Quantum Algorithms<span class="wordmark-sub">STEP BY STEP</span></span></a><div class="top-actions"><a href="/search/" class="search-link" aria-label="Search the textbook">Search</a><button id="theme-toggle" aria-label="Switch to dark theme">Dark theme</button></div></header>
<div id="menu-backdrop" hidden></div>
<aside id="sidebar" class="sidebar" aria-label="Textbook navigation"><div class="sidebar-top"><span class="eyebrow">THE TEXTBOOK</span><button id="menu-close" class="mobile-menu" aria-label="Close contents">✕</button></div><a href="/" class:list={['orientation-link',{active:current==='orientation'}]}>00. How to use this book</a>
<nav aria-label="Decision path" class="decision-nav"><details class="module decision-module" open><summary><span class="module-number">◆</span>Decision path <small class="module-count">{decision.length} lessons</small></summary><ol>{decision.map(l=><li><a href={`/lessons/${l.id}/`} class:list={[{'is-current':l.id===current}]}><span class="lesson-number">{String(l.sequence).padStart(2,'0')}</span><span>{l.title}</span></a></li>)}</ol><a class="path-link" href="/path/">About this path →</a></details></nav>
<div class="sidebar-group-head"><span class="eyebrow">ALL LESSONS BY MODULE</span><button id="toggle-deferred" type="button" aria-pressed="false" aria-controls="module-nav">Show deferred branches ({deferredCount})</button></div>
<nav aria-label="Modules" id="module-nav">{moduleNames.slice(1).map((name,i)=>{const group=lessons.filter(l=>l.module===i+1);return group.length>0&&<details class:list={['module',{'all-deferred':group.every(l=>tier(l)==='deferred')&&!group.some(l=>l.id===current)}]} open={group.some(l=>l.id===current)||i===0}><summary><span class="module-number">{String(i+1).padStart(2,'0')}</span>{name}</summary><ol>{group.map(l=><li class:list={[`tier-${tier(l)}`,{current:l.id===current}]}>{l.editorial==='planned'?<span class="planned">{label(l)} <small>Planned</small></span>:<a href={`/lessons/${l.id}/`} data-sequence={l.sequence} aria-current={l.id===current?'page':undefined}><span class="lesson-number">{String(l.sequence).padStart(2,'0')}</span><span>{l.title}{tier(l)==='decision'&&<span class="tier-mark"><span aria-hidden="true"> ◆</span><span class="sr-only"> (decision path)</span></span>}{l.editorial==='partial'&&<small class="draft-label">Partial chapter</small>}</span></a>}</li>)}</ol></details>})}</nav>
<nav class="library-nav" aria-label="Learning tools"><span class="eyebrow">REFERENCE DESK</span><a href="/path/">Decision path (default)</a><a href="/path/complete/">Complete algorithms path</a><a href="/index/">Algorithm index & families</a><a href="/glossary/">Definitions & symbols</a><a href="/prerequisites/">Prerequisite map</a><a href="/coverage/">Coverage & editorial audit</a><a href="/references/">Source library</a><a href="/progress/">Your reading progress</a></nav><p class="sidebar-note">Read the algorithm. Follow a missing idea. Return to the calculation.</p></aside>
<div class="reading-layout"><main id="main" tabindex="-1"><slot/></main>{sections.length>0&&<aside class="page-toc" aria-label="On this page"><details class="toc-details" open><summary class="eyebrow">{tocLabel}<span class="toc-count"> · {sections.length} sections</span></summary><nav>{sections.map(s=><a href={`#${s.id}`} data-section-link={s.id}>{s.title}</a>)}</nav></details><div class="reading-tools"><button id="full-detail" aria-pressed="false">Show all derivations</button><button id="print-page">Print / save PDF</button></div></aside>}</div>
<footer class="book-footer">Quantum Algorithms, Step by Step · Local-first learning · <a href="/coverage/">Scope, sources, and limitations</a></footer>
<dialog id="definition-dialog" aria-labelledby="definition-title"><div class="definition-toolbar"><button id="definition-back">← Return</button><button id="definition-close" aria-label="Close explanation and return to lesson">✕</button></div><p id="definition-stack" class="eyebrow"></p><p id="definition-origin" class="small muted"></p><h2 id="definition-title"></h2><div id="definition-body" class="prose"></div><a id="definition-permalink" href="/glossary/">Open this definition as a page</a></dialog>
<script>
import '../lib/reader';
</script>
</body></html>
