---
import Book from '../../layouts/Book.astro';import{lessons,moduleNames,label}from'../../lib/content';
---
<Book title="Algorithm index and families"><span class="eyebrow">BROWSE THE COMPLETE MAP</span><h1>Algorithm index & families</h1><p class="dek">Stable numbers describe a recommended traversal. They never prevent you from opening a later topic.</p><nav class="family-nav" aria-label="Algorithm families">{moduleNames.slice(1).map((name,i)=><a href={`#module-${i+1}`}>{String(i+1).padStart(2,'0')} {name}</a>)}</nav>{moduleNames.slice(1).map((name,i)=><section id={`module-${i+1}`}><h2>Module {i+1}. {name}</h2><ul class="catalog-list">{lessons.filter(l=>l.module===i+1).map(l=><li>{l.editorial==='planned'?<strong>{label(l)} · Planned</strong>:<a href={`/lessons/${l.id}/`}>{label(l)}</a>}<p>{l.summary}</p><div class="inline-meta"><span class="badge">{l.kind}</span><span class="badge">{l.path}</span><span class:list={['badge',{partial:l.editorial==='partial'}]}>{l.editorial}</span></div></li>)}</ul></section>)}</Book>
