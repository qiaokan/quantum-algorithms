{
  "name": "quantum-algorithms-step-by-step",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {"node": "24.x"},
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check",
    "test": "vitest run",
    "test:browser": "playwright test",
    "audit:content": "tsx scripts/audit-content.ts",
    "build": "npm run audit:content && astro build",
    "preview": "astro preview --host 127.0.0.1",
    "validate": "npm run check && npm test && npm run build && npm run test:browser"
  },
  "dependencies": {
    "astro": "7.4.4",
    "katex": "^0.19.1",
    "unified": "^11.0.5",
    "remark-parse": "^11.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-rehype": "^11.1.2",
    "rehype-raw": "^7.0.0",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "@types/katex": "^0.16.7",
    "typescript": "^5.9.3",
    "tsx": "^4.20.0",
    "vitest": "5.0.5",
    "@axe-core/playwright": "^4.11.0"
  }
}
